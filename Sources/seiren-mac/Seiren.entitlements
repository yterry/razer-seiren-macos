<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime (required for notarization) blocks microphone access
	     unless the app declares it. This is the only entitlement the app
	     needs: the mic is its whole reason to exist, and HID lighting control
	     is gated by the Input Monitoring TCC prompt, not an entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
